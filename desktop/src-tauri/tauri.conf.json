{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NorthBridge AgentNET",
  "version": "0.1.0",
  "identifier": "com.northbridge.agentnet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label": "main", "title": "NorthBridge AgentNET", "width": 1440, "height": 960, "minWidth": 1024, "minHeight": 720}],
    "security": {"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agentgateway"],
    "resources": ["resources"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
